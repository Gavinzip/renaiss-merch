{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "renaiss-merch-private-media",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://merch.renaisscltb.com",
    "SIGNED_URL_MAX_TTL_SECONDS": "300"
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "renaiss-merch-private-media"
    }
  ]
}
