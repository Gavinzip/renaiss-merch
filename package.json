{
  "name": "renaiss-merch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "build": "node scripts/r2-merch-assets.mjs assert-config && tsc -b && vite build && node scripts/r2-merch-assets.mjs assert-build",
    "assets:audit": "node scripts/r2-merch-assets.mjs audit --catalog media/public-asset-release.json",
    "assets:prepare": "node scripts/r2-merch-assets.mjs prepare --catalog media/public-asset-release.json",
    "assets:publish": "node scripts/r2-merch-assets.mjs publish --catalog media/public-asset-release.json --bucket renaiss-merch-media",
    "assets:verify": "node scripts/r2-merch-assets.mjs verify --catalog media/public-asset-release.json",
    "assets:private:audit": "node scripts/r2-merch-assets.mjs audit --catalog media/private-asset-release.json",
    "assets:private:publish": "node scripts/r2-merch-assets.mjs publish --catalog media/private-asset-release.json --bucket renaiss-merch-private-media",
    "assets:private:verify": "node scripts/r2-merch-assets.mjs verify --catalog media/private-asset-release.json",
    "preview": "npm run build && NODE_ENV=production node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.2.0",
    "ogl": "^1.0.11",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  }
}
