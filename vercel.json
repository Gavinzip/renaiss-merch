{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/vercel-finalize.mjs && node scripts/install-backup-tools.mjs",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 800,
      "includeFiles": "server/vendor/backup/**"
    }
  },
  "redirects": [
    {
      "source": "/v1.2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v1.2/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v1.2/:path+",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/verify",
      "destination": "/v1.2/index.html"
    },
    {
      "source": "/verify/",
      "destination": "/v1.2/index.html"
    },
    {
      "source": "/events/pokemon-30",
      "destination": "/events/pokemon-30/index.html"
    },
    {
      "source": "/events/pokemon-30/",
      "destination": "/events/pokemon-30/index.html"
    },
    {
      "source": "/events/football",
      "destination": "/events/football/index.html"
    },
    {
      "source": "/events/football/",
      "destination": "/events/football/index.html"
    },
    {
      "source": "/local-draw-operator",
      "destination": "/api/index"
    },
    {
      "source": "/next",
      "destination": "/v1.2/index.html"
    },
    {
      "source": "/next/",
      "destination": "/v1.2/index.html"
    },
    {
      "source": "/draw",
      "destination": "/draw/index.html"
    },
    {
      "source": "/draw/",
      "destination": "/draw/index.html"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/v1.2/index.html"
    },
    {
      "source": "/next/:path*",
      "destination": "/v1.2/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/events/football/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/events/pokemon-30/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/internal/backup/check/cron",
      "schedule": "40 19 1 * *"
    }
  ]
}
