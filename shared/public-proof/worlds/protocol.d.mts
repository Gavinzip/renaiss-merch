import type { ProofBundle, ProofManifest, ProofCommitment, ProofPick, ChainFacts } from '../types';
export const PROTOCOL: string;
export const PROTOCOL_HASH: string;
export const CAMPAIGN: string;
export const POLICY: object;
export function canonical(value: unknown): string;
export function digest(value: unknown): string;
export function same(a: unknown, b: unknown): boolean;
export function hash32(value: unknown): boolean;
export function requireThat(value: unknown, message: string): asserts value;
export function roundIdFor(stage: string): string;
export function matchKeyFor(match: string): string;
export function validateManifest(manifest: ProofManifest): ProofManifest;
export type TicketTree = { root: string; tickets: ProofPick[]; offsets: Map<string, number>; proof(position: number): string[] };
export function buildTicketTree(manifest: ProofManifest): TicketTree;
export function commitmentFor(manifest: ProofManifest, tree?: TicketTree): Omit<ProofCommitment, 'publicKey'>;
export function deriveAlpha(commitment: ProofCommitment, facts: ChainFacts): string;
export function verifiedBeta(key: string, alpha: string, proof: string): string;
export function selectTickets(manifest: ProofManifest, beta: string, tree?: TicketTree): ProofBundle['result'];
export function verifyInclusion(ticket: ProofPick, path: string[], root: string, roundId: string): boolean;
export function verifyBundle(bundle: ProofBundle, expectedHash?: string, tree?: TicketTree): { root: string; alpha: string; beta: string; resultHash: string; bundleHash: string; picks: ProofPick[] };
